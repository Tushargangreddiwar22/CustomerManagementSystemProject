@model Customer

@{
    ViewData["Title"] = "Add Customer";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">

    <div class="card shadow-lg rounded-4">

        <!-- Header -->
        <div class="card-header bg-primary text-white text-center rounded-top-4">
            <h2>➕ Add New Customer</h2>
        </div>

        <!-- Body -->
        <div class="card-body">

            <form asp-controller="Customer" asp-action="AddCustomer" method="post">

                <!-- Validation Summary -->
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="row g-3">

                    <!-- Custid -->
                    <div class="col-md-6">
                        <label asp-for="Custid" class="form-label fw-bold"></label>
                        <input asp-for="Custid" class="form-control" placeholder="Enter Customer ID" />
                        <span asp-validation-for="Custid" class="text-danger"></span>
                    </div>

                    <!-- Name -->
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-bold"></label>
                        <input asp-for="Name" class="form-control" placeholder="Enter Name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <!-- Balance -->
                    <div class="col-md-6">
                        <label asp-for="Balance" class="form-label fw-bold"></label>
                        <input asp-for="Balance" class="form-control" placeholder="Enter Balance" />
                        <span asp-validation-for="Balance" class="text-danger"></span>
                    </div>

                    <!-- City -->
                    <div class="col-md-6">
                        <label asp-for="City" class="form-label fw-bold"></label>
                        <input asp-for="City" class="form-control" placeholder="Enter City" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>

                    <!-- Status -->
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label fw-bold"></label>

                        <select asp-for="Status" class="form-select">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>

                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                </div>

                <!-- Buttons -->
                <div class="mt-4 text-center">

                    <button type="submit" class="btn btn-success px-4">
                        💾 Save
                    </button>

                    <button type="reset" class="btn btn-secondary px-4">
                        🔄 Reset
                    </button>

                    <a asp-action="DisplayCustomers" class="btn btn-dark px-4">
                        🔙 Back
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- Validation Scripts -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}