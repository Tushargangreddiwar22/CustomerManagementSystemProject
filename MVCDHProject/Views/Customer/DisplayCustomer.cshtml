@model Customer

@{
    ViewData["Title"] = "Customer Details";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">

    <div class="card shadow-lg rounded-4">

        <!-- Header -->
        <div class="card-header bg-success text-white text-center rounded-top-4">
            <h2>Customer Details</h2>
        </div>

        <!-- Body -->
        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3 fw-bold">Customer ID</dt>
                <dd class="col-sm-9">@Model.Custid</dd>

                <dt class="col-sm-3 fw-bold">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3 fw-bold">Balance</dt>
                <dd class="col-sm-9 text-success fw-bold">₹ @Model.Balance</dd>

                <dt class="col-sm-3 fw-bold">City</dt>
                <dd class="col-sm-9">@Model.City</dd>

                <dt class="col-sm-3 fw-bold">Status</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-@(Model.Status ? "success" : "danger")">
                        @(Model.Status ? "Active" : "Inactive")
                    </span>
                </dd>

            </dl>

        </div>

        <!-- Footer -->
        <div class="card-footer text-center">

            <a asp-action="EditCustomer" asp-route-Custid="@Model.Custid"
               class="btn btn-warning">✏ Edit</a>

            <a asp-action="DeleteCustomer" asp-route-Custid="@Model.Custid"
               class="btn btn-danger">🗑 Delete</a>

            <a asp-action="DisplayCustomers" class="btn btn-secondary">
                ⬅ Back
            </a>

        </div>

    </div>

</div>