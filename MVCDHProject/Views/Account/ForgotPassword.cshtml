@model ChangePasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<style>
    body {
        background: linear-gradient(135deg, #f6c23e, #e74a3b);
        height: 100vh;
    }

    .forgot-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 90vh;
    }

    .card {
        width: 380px;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        padding: 25px;
        background: white;
        text-align: center;
    }

        .card h2 {
            margin-bottom: 10px;
            font-weight: bold;
            color: #e74a3b;
        }

        .card p {
            font-size: 14px;
            color: #666;
            margin-bottom: 20px;
        }

    .form-control {
        border-radius: 10px;
    }

    .btn-custom {
        width: 100%;
        border-radius: 10px;
        margin-top: 10px;
    }

    .back-link {
        margin-top: 15px;
    }

        .back-link a {
            color: #e74a3b;
            font-weight: bold;
            text-decoration: none;
        }

            .back-link a:hover {
                text-decoration: underline;
            }
</style>

<div class="forgot-container">
    <div class="card">
        <h2>Forgot Password?</h2>
        <p>Enter your username to receive a reset link</p>

        <form asp-action="ForgotPassword">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <input asp-for="Name" class="form-control" placeholder="Enter Username" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <input type="submit" value="Send Reset Link" class="btn btn-danger btn-custom" />
            <input type="reset" value="Reset" class="btn btn-secondary btn-custom" />
        </form>

        <div class="back-link">
            Remember your password? <a asp-action="Login">Back to Login</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}