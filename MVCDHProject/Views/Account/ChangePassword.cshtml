@model MVCDHProject.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    var UserId = Context.Request.Query["UserId"];
    var Token = Context.Request.Query["Token"];
}

<style>
    body {
        background: linear-gradient(135deg, #1cc88a, #4e73df);
        height: 100vh;
    }

    .reset-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 90vh;
    }

    .card {
        width: 400px;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        padding: 25px;
        background: white;
        text-align: center;
    }

        .card h2 {
            margin-bottom: 10px;
            font-weight: bold;
            color: #4e73df;
        }

        .card p {
            font-size: 14px;
            color: #666;
            margin-bottom: 20px;
        }

    .form-control {
        border-radius: 10px;
    }

    .btn-custom {
        width: 100%;
        border-radius: 10px;
        margin-top: 10px;
    }

    .back-link {
        margin-top: 15px;
    }

        .back-link a {
            color: #4e73df;
            font-weight: bold;
            text-decoration: none;
        }

            .back-link a:hover {
                text-decoration: underline;
            }
</style>

<div class="reset-container">
    <div class="card">
        <h2>Reset Password</h2>
        <p>Enter your new password below</p>

        <form asp-action="ChangePassword" asp-route-UserId="@UserId" asp-route-Token="@Token">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-2">
                <input asp-for="Password" type="password" class="form-control" placeholder="New Password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm Password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <input type="submit" value="Update Password" class="btn btn-success btn-custom" />
            <input type="reset" value="Reset" class="btn btn-secondary btn-custom" />
        </form>

        <div class="back-link">
            <a asp-action="Login">Back to Login</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}